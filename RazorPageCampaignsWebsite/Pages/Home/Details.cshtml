@page
@model RazorPageCampaignsWebsite.Pages.Home.DetailsModel

@* Use the ViewModel property - already populated by the base class! *@


@* Optional: Display type information *@
@if (!string.IsNullOrEmpty(Model.ViewModel.ModelType))
{
    <p class="text-muted" style="display:none;">Content Type: @Model.ViewModel.ModelType</p>
      @Html.Raw(string.Format("{0}",@Model.ViewModel.DataMessage))
}

<bg-model model="@Model.ViewModel" />

<style type="text/css">
    main {
        max-width: 1068px !important;
    }
</style>
