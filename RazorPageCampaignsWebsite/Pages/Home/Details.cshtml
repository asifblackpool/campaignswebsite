
@page
@using Content.Modelling.Helpers
@using Content.Modelling.Models.Canvas.Helpers;
@using Content.Modelling.Models.Canvas.Code
@using Content.Modelling.Models.Canvas.Headers
@using Content.Modelling.Models.Canvas.Lists
@using Content.Modelling.Models.Canvas.Paragraphs
@using Content.Modelling.Models.Canvas.Images
@using Newtonsoft.Json;
@using RazorPageCampaignsWebsite.Helpers;
@using Content.Modelling.Models.Templates
@using Content.Modelling.Models.GenericTypes;
@using System.Text


@model RazorPageCampaignsWebsite.Pages.Home.DetailsModel
@{
    BGStandard? entryModel = (Model != null && Model.Items.Count == 1) ? Model.Items.FirstOrDefault() : null;
}

@if (entryModel != null)
{
    @try
    {

        @await Component.InvokeAsync("Canvas", entryModel.GetSerialisedCanvas())
    }
    catch (Exception ex)
    {
        <div class="alert alert-danger">@ex.Message</div>
    }
}
else
{
    <h1>Root details pages not found </h1>
}
<style type="text/css">
    main {
        max-width: 1068px !important;
    }
</style>
